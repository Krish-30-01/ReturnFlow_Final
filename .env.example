# ReturnFlow environment variables
# Copy this file to .env and fill in your credentials.

# Supabase — Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay (optional) — Dashboard → Settings → API Keys → Test key id (rzp_test_...)
# When set, escrow payments open the real Razorpay Checkout sheet in test mode.
VITE_RAZORPAY_KEY_ID=
